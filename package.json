{
  "name": "plataforma-escolar",
  "private": true,
  "description": "Plataforma para colegios: matrícula y notas, facturación y wallet escolar.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "pnpm --filter @escolar/identity db:seed",
    "db:seed:demo": "pnpm --filter @escolar/academic db:seed",
    "db:seed:region": "pnpm --filter @escolar/academic db:seed:region",
    "keys:generate": "pnpm --filter @escolar/identity keys:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
