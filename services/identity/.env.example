# Copia este archivo a .env y genera las llaves con:  pnpm keys:generate >> services/identity/.env
DATABASE_URL=postgres://escolar:escolar@localhost:5432/escolar_identity
PORT=3001
LOG_PRETTY=true

# Datos iniciales (pnpm db:seed)
SEED_SUPERADMIN_EMAIL=superadmin@escolar.local
SEED_SUPERADMIN_PASSWORD=Cambia-esta-clave-2026
SEED_DEMO=true
SEED_DEMO_PASSWORD=Demo-colegio-2026

