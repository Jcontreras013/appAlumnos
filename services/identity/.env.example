# Copia este archivo a .env y genera las llaves con:  pnpm keys:generate >> services/identity/.env
DATABASE_URL=postgres://escolar:escolar@localhost:5432/escolar_identity
PORT=3001
LOG_PRETTY=true

# Datos iniciales (pnpm db:seed)
SEED_SUPERADMIN_EMAIL=superadmin@escolar.local
SEED_SUPERADMIN_PASSWORD=Cambia-esta-clave-2026
SEED_DEMO=true
SEED_DEMO_PASSWORD=Demo-colegio-2026

# Verificación en dos pasos obligatoria para la departamental, la distrital y la plataforma.
# Siempre "true" en producción; "false" solo en demos (queda opcional en «Mi cuenta»).
REQUIRE_MFA=false

# JWT_KEY_ID=...
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Avisos de mensajes al celular (opcional). Sin estas llaves los mensajes funcionan, sin avisos.
# Genéralas con:  pnpm push:keys tu-correo@dominio.hn >> services/identity/.env
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:tu-correo@dominio.hn

# Fotos, videos y documentos de los mensajes. En desarrollo, una carpeta (por defecto .adjuntos);
# en AWS, un bucket de S3 privado (lo pone la infraestructura).
# FILES_DIR=.adjuntos
# FILES_BUCKET=nombre-del-bucket
