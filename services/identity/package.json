{
  "name": "@escolar/identity",
  "version": "0.0.0",
  "private": true,
  "description": "Servicio de identidad: colegios (tenants), usuarios, roles, login y emisión de tokens.",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "keys:generate": "tsx src/scripts/generate-keys.ts",
    "push:keys": "tsx src/scripts/generate-push-keys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@escolar/service-kit": "workspace:*",
    "@escolar/shared": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
