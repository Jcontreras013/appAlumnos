DATABASE_URL=postgres://escolar:escolar@localhost:5432/escolar_academic
PORT=3002
LOG_PRETTY=true
# De aquí salen las llaves públicas para verificar tokens (JWKS) y la validación de docentes.
IDENTITY_URL=http://localhost:3001
# Solo para `pnpm --filter @escolar/academic db:seed` (datos demo, cargados vía API)
SEED_DEMO_PASSWORD=Demo-colegio-2026

# Solo para `pnpm db:seed:region` (departamento de demostración, cargado vía API)
SEED_SUPERADMIN_EMAIL=superadmin@escolar.local
SEED_SUPERADMIN_PASSWORD=Cambia-esta-clave-2026

# Asistente de planificación con IA. Sin llave, el asistente aparece como no disponible.
# Gemini (Google; la llave gratis se saca en aistudio.google.com → Get API key):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # opcional: fija una versión en producción
# Groq (capa gratuita sin tarjeta; la llave se saca en console.groq.com → API Keys):
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # opcional
# Claude (Anthropic; console.anthropic.com):
# ANTHROPIC_API_KEY=
# PLAN_ASSISTANT_PROVIDER=groq   # con varias llaves elige cuál usar (por defecto: claude, gemini, groq)
# PLAN_ASSISTANT=off   # apaga el asistente aunque haya llave
